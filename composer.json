{
    "name": "adityad1997/filament-kit",
    "description": "Small reusable Filament helpers (macros/traits) for Laravel apps.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aditya",
            "homepage": "https://github.com/adityad1997"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Adityad1997\\FilamentKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Adityad1997\\FilamentKit\\FilamentKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0"
}
